# ─── DeepSeek (solo servidor — NUNCA en el frontend) ───
DEEPSEEK_API_KEY=TU API KEY DE DEEPSEEK
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_RETRIES=3

# ─── PDF / OCR ───
MAX_PDF_TEXT_CHARS=100000
MIN_PDF_TEXT_CHARS=80
OCR_MAX_PAGES=7

# ─── Wompi (Colombia — tarjeta, PSE, Nequi) ───
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=prod_integrity_...
WOMPI_EVENTS_SECRET=prod_events_...

# Días antes de borrar PDFs exportados en Storage (regenerables)
STORAGE_EXPORT_RETENTION_DAYS=30

# ─── PayPal (resto LATAM — tarjetas USD) ───
# Crear planes en https://developer.paypal.com (sandbox primero):
#   - Mensual: USD 11/mes → PAYPAL_PLAN_ID_MONTHLY
#   - Anual: USD 110/año → PAYPAL_PLAN_ID_ANNUAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=

# URL pública del frontend (redirect post-pago)
APP_URL=http://localhost:5173

# Orígenes permitidos para CORS (separados por coma; por defecto APP_URL)
CORS_ORIGINS=http://localhost:5173

# ─── Base jurídica / RAG ───
LEGAL_SEARCH_PROVIDER=firestore
LEGAL_DEFAULT_COUNTRY=CO
LEGAL_MAX_ARTICLES=30
LEGAL_CLASSIFIER_MIN_SCORE=2

# ─── Entorno ───
NODE_ENV=development

# ─── Emuladores (desarrollo local) ───
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# NOTA SOBRE SECRETOS EN LOCAL
# Las variables declaradas con defineSecret (WOMPI_PRIVATE_KEY,
# WOMPI_INTEGRITY_SECRET, WOMPI_EVENTS_SECRET, PAYPAL_CLIENT_SECRET,
# PAYPAL_WEBHOOK_ID, DEEPSEEK_API_KEY) NO se leen de este archivo cuando
# corren los emuladores: firebase-tools va a Secret Manager y falla con 403
# si la API no esta habilitada en el proyecto. El override local va en
# backend/functions/.secret.local (gitignored), con el mismo formato
# CLAVE=valor. Para desarrollo bastan valores ficticios; el simulador
# `pnpm --filter @clausum/functions sim:wompi` firma los eventos con el
# mismo WOMPI_EVENTS_SECRET que lea el backend.
