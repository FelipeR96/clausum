# Variables de entorno del proyecto clausum-dev.
#
# Firebase carga este archivo al desplegar a este proyecto (se llama igual
# que el project id). NO lleva secretos: esos van por Secret Manager con
# `firebase functions:secrets:set`. Lo de aqui es configuracion publica,
# por eso el archivo si esta en el repo.
#
# .env.local es lo contrario: solo lo leen los emuladores y nunca se
# despliega.

# ── CORS ─────────────────────────────────────────────────────────────────
# Sin esto, la lista de origenes permitidos cae al valor por defecto
# (http://localhost:5173) y el sitio desplegado se rechaza a si mismo con
# "Origen no permitido". El sintoma engania: todo parece funcionar hasta que
# algo intenta escribir, porque el navegador solo manda la cabecera Origin
# en peticiones que no son GET ni HEAD.
#
# Firebase Hosting sirve el mismo sitio en dos dominios y los dos tienen que
# estar aqui. Al conectar un dominio propio, anadirlo tambien.
CORS_ORIGINS=https://clausumlegal.com,https://www.clausumlegal.com,https://clausum-dev.web.app,https://clausum-dev.firebaseapp.com

# ── URL de la aplicacion ─────────────────────────────────────────────────
# La usan Wompi y PayPal para construir la URL de retorno despues del pago.
# Con el valor por defecto (localhost:5173) el usuario acabaria en una
# pagina que no existe al volver de la pasarela.
APP_URL=https://clausumlegal.com

# ── Pagos ────────────────────────────────────────────────────────────────
# La llave publica de Wompi no es secreta: viaja al navegador dentro del
# widget. Por eso va aqui y no en Secret Manager.
# Pendiente: pegar la llave pub_test_ real del panel de Wompi. Mientras
# este vacia, getWompiConfig() devuelve null y los endpoints de pago
# responden 503.
WOMPI_PUBLIC_KEY=pub_prod_oXpZRGrBANko5rTBahkGmRvJqSOXtUJH

PAYPAL_MODE=live

# El Client ID de PayPal no es secreto: viaja en cada peticion. El Secret y
# el Webhook ID si, y van por Secret Manager.
PAYPAL_CLIENT_ID=BAAYS7f0TepsdKy4dB2jIBabF73ukziPFDfnppgERGM9QwBO8prC4PHhHXF8h4Fg_VbOa3ZOWydizkB8nE

# Los planes llevan el precio DENTRO, en PayPal. Cambiar el precio LATAM
# desde el panel de administracion no cambia lo que PayPal cobra: hay que
# crear planes nuevos alli. Por eso el importe que se registra de cada pago
# se toma del evento de PayPal y no de config/pricing.
PAYPAL_PLAN_ID_MONTHLY=P-85058049TF1719629NLJZTJY
PAYPAL_PLAN_ID_ANNUAL=P-3VL850318U069433JNLJZTJY

# ── Correo saliente (Hostinger) ─────────────────────────────────────────
# Desde aqui salen los informes de la compra sin cuenta. La contrasena NO
# vive aqui: es un secreto de Secret Manager (SMTP_PASSWORD).
#
# El remitente es el mismo buzon de soporte a proposito. Quien acaba de
# pagar y responde al correo --porque no le llego bien o tiene una duda--
# escribe a una direccion que alguien lee. Un no-responder@ tiraria esa
# respuesta al vacio justo despues de cobrarle.
#
# Sin SMTP_PORT: por defecto usa 465, que es TLS desde el saludo. Google
# Cloud bloquea el 25 SIEMPRE, y por ahi un envio no falla con un error
# legible: se queda colgado hasta que vence el tiempo.
SMTP_HOST=smtp.hostinger.com
SMTP_USER=soporte@clausumlegal.com
MAIL_FROM=Clausum <soporte@clausumlegal.com>
