# ─── Firebase (públicas — seguras de exponer en el cliente) ───
# Obtén estos valores en: Firebase Console → Configuración del proyecto → Tus apps → Web

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=TU-PROYECTO-ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TU-PROYECTO-ID
VITE_FIREBASE_STORAGE_BUCKET=TU-PROYECTO-ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ─── Emuladores (solo desarrollo local) ───
# Pon "true" para conectar React a emuladores en lugar de producción
VITE_USE_FIREBASE_EMULATORS=true

VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# ─── API ───
# En dev local usa el proxy de Vite (/api → emulador Functions).
# VITE_FIREBASE_PROJECT_ID debe coincidir con tu proyecto Firebase (también usado por el proxy).
VITE_API_BASE_URL=/api

# ─── SEO (dominio canónico único) ───
VITE_SITE_URL=https://clausumlegal.com
