{
  "name": "clausum",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "description": "SaaS de análisis de contratos con IA",
  "scripts": {
    "dev": "pnpm --filter @clausum/web dev",
    "dev:emulators": "pnpm --filter @clausum/functions build && node scripts/start-emulators.mjs",
    "dev:all": "concurrently -n web,emu -c blue,green \"node scripts/wait-for-functions-emulator.mjs && pnpm dev\" \"pnpm dev:emulators\"",
    "build": "pnpm --filter @clausum/shared build && pnpm --filter @clausum/web build && pnpm --filter @clausum/functions build",
    "build:web": "pnpm --filter @clausum/web build",
    "build:functions": "pnpm --filter @clausum/functions build",
    "deploy": "pnpm build && firebase deploy --config backend/firebase/firebase.json",
    "deploy:hosting": "pnpm build:web && firebase deploy --only hosting --config backend/firebase/firebase.json",
    "deploy:functions": "pnpm build:functions && firebase deploy --only functions --config backend/firebase/firebase.json",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --config backend/firebase/firebase.json",
    "seed:firestore": "pnpm --filter @clausum/functions seed",
    "seed:legal-catalog": "pnpm --filter @clausum/functions seed:legal-catalog",
    "import:co-corpus": "pnpm --filter @clausum/functions import:co-corpus",
    "build:co-corpus": "pnpm --filter @clausum/functions build:co-corpus",
    "test:api": "pnpm --filter @clausum/functions test:api",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use --config backend/firebase/firebase.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulators": "firebase emulators:exec --only firestore,storage,auth --config backend/firebase/firebase.json --project clausum-test \"pnpm test\"",
    "lint:strict": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase": "^11.1.0",
    "firebase-tools": "^13.29.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
